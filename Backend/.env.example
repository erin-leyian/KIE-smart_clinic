# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# Email Configuration (Optional - for sending notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@smartclinic.com

# SMS Configuration (Optional - for SMS notifications)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Application Settings
APP_NAME=KIE Smart Clinic
APP_VERSION=1.0.0
API_BASE_URL=http://localhost:3000

# CORS Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Database Connection Pool (if applicable)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Features Toggle
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ONLINE_CONSULTATIONS=true

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
SESSION_TIMEOUT=3600000

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Configuration
ADMIN_EMAIL=admin@smartclinic.com
ADMIN_PASSWORD=change-this-default-password

# Analytics (Optional)
ANALYTICS_ENABLED=false
ANALYTICS_KEY=your-analytics-key

# Error Tracking (Optional)
SENTRY_DSN=

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Security Headers
HELMET_ENABLED=true
